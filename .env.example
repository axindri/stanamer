# Host port for the UI (mapped to frontend nginx)
STANAMER_PORT=8080

APP_ENV=production
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# OpenAI-compatible gateway (corporate / Groq / OpenRouter / Ollama)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-token-here
OPENAI_MODEL=qwen/qwen3.8-27b

# TLS: by default uses OS trust store (like VS Code), not only certifi.
# OPENAI_VERIFY_SSL=false          # last resort for broken MITM
# OPENAI_CA_BUNDLE=/certs/rootca.crt  # Docker: mount ./certs
# OPENAI_CA_BUNDLE=../certs/rootca.crt # local from backend/
OPENAI_VERIFY_SSL=true
# OPENAI_CA_BUNDLE=

