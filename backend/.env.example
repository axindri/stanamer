# Prefer the root ../.env for Docker.
# For local uvicorn you can keep a copy here or rely on ../.env.

APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-token-here
OPENAI_MODEL=qwen/qwen3.8-27b

# Uses OS trust store by default (like VS Code). Optional corp CA:
OPENAI_VERIFY_SSL=true
# OPENAI_CA_BUNDLE=../certs/rootca.crt
